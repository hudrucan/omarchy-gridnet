#!/usr/bin/env python3
"""Build and own the native module for the lifetime of an Omarchy service."""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent


def run(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=30)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f"{args[0]} failed")
    return result.stdout.strip()


def build():
    flags = shlex.split(run("pkg-config", "--cflags", "--libs", "hyprland"))
    compiler = shlex.split(os.environ.get("CXX", "g++"))
    # version.h includes Hyprland's commit and the hypr* dependency versions.
    includes = [Path(flag[2:]) for flag in flags if flag.startswith("-I")]
    candidates = [p / name for p in includes for name in ["src/version.h", "hyprland/src/version.h"]]
    version = next((p for p in candidates if p.is_file()), None)
    if version is None:
        raise RuntimeError("Hyprland development headers (src/version.h) were not found through pkg-config")
    digest = hashlib.sha256(version.read_bytes() + repr(flags).encode() + repr(compiler).encode())
    for source in sorted((ROOT / "native").glob("*")):
        if source.is_file():
            digest.update(source.read_bytes())
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omasnap-window-snap"
    cache.mkdir(parents=True, exist_ok=True)
    output = cache / f"omasnap-{digest.hexdigest()[:20]}.so"
    if output.is_file():
        return output
    print("Omasnap: building the native module for installed Hyprland headers", file=sys.stderr)
    with tempfile.TemporaryDirectory(prefix="build-", dir=cache) as temporary:
        compiled = Path(temporary) / "omasnap.so"
        result = subprocess.run([
            *compiler, "-std=c++26", "-shared", "-fPIC", "-O2", "-Wall", "-Wextra", "-Wno-unused-parameter",
            str(ROOT / "native/plugin.cpp"), "-o", str(compiled), *flags,
        ], timeout=180)
        if result.returncode:
            raise RuntimeError("native build failed; see compiler output above")
        compiled.chmod(0o755)
        compiled.replace(output)
    return output


def configure(line):
    settings = json.loads(line)
    values = []
    for key, default, minimum, maximum in [("edge", 24, 4, 100), ("corner", 160, 16, 500), ("gap", 8, 0, 100)]:
        value = settings.get(key, default)
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not minimum <= value <= maximum:
            raise ValueError(f"{key} must be between {minimum} and {maximum}")
        values.append(str(value))
    for key in ["preview", "keepVisible"]:
        value = settings.get(key, True)
        if not isinstance(value, bool):
            raise ValueError(f"{key} must be boolean")
        values.append(str(int(value)))
    color = settings.get("color", "#59a6ff")
    if not isinstance(color, str) or len(color) != 7 or not color.startswith("#"):
        raise ValueError("color must be #rrggbb")
    int(color[1:], 16)
    values.append(color[1:])
    reply = run("hyprctl", "omasnap", "configure " + " ".join(values))
    if reply != "ok":
        raise RuntimeError(reply)


def runtime_files():
    runtime = Path(os.environ["XDG_RUNTIME_DIR"]) / "omasnap-window-snap"
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not signature:
        raise RuntimeError("HYPRLAND_INSTANCE_SIGNATURE is missing")
    instance = hashlib.sha256(signature.encode()).hexdigest()[:16]
    return runtime / f"{instance}.lock", runtime / f"{instance}.json"


def unload(state_file, token=None):
    if not state_file.exists():
        return
    state = json.loads(state_file.read_text())
    if token is not None and state["token"] != token:
        return
    result = subprocess.run(["hyprctl", "plugin", "unload", state["library"]], text=True,
                            capture_output=True, timeout=30)
    reply = result.stdout.strip()
    if reply != "ok" and "not loaded" not in reply.lower():
        raise RuntimeError(f"could not unload native module: {reply or result.stderr.strip()}")
    state_file.unlink()


def serve(token):
    lock_file, state_file = runtime_files()
    with lock_file.open("a") as lock:
        # Serialize module transitions; lifetime tokens protect later owners
        # from a delayed cleanup during hot reload.
        fcntl.flock(lock, fcntl.LOCK_EX)
        library = build()
        # Recover a previous service killed by QML before its finally block.
        unload(state_file)
        loaded = False
        try:
            state_file.write_text(json.dumps({"token": token, "library": str(library)}))
            reply = run("hyprctl", "plugin", "load", str(library))
            if reply != "ok":
                raise RuntimeError(reply)
            loaded = True
            status = json.loads(run("hyprctl", "omasnap", "status"))
            if status.get("ready") is not True:
                raise RuntimeError("native module did not become ready")
            print("ready", flush=True)
            fcntl.flock(lock, fcntl.LOCK_UN)
            for line in sys.stdin:
                if line.strip() == "quit":
                    break
                fcntl.flock(lock, fcntl.LOCK_EX)
                try:
                    if not state_file.exists() or json.loads(state_file.read_text())["token"] != token:
                        break
                    configure(line)
                except (ValueError, RuntimeError) as error:
                    print(f"Omasnap: {error}", file=sys.stderr, flush=True)
                finally:
                    fcntl.flock(lock, fcntl.LOCK_UN)
        finally:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if loaded:
                unload(state_file, token)
            elif state_file.exists():
                state_file.unlink()


def stop_service(token):
    lock_file, state_file = runtime_files()
    with lock_file.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # A delayed destruction callback must not unload a newer service.
        unload(state_file, token)


def stop(_signum, _frame):
    raise SystemExit(0)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["build", "run", "stop"])
    parser.add_argument("token", nargs="?")
    args = parser.parse_args()
    for sig in [signal.SIGTERM, signal.SIGINT, signal.SIGHUP]:
        signal.signal(sig, stop)
    try:
        if args.action == "build":
            print(build())
        elif not args.token:
            parser.error("run and stop require a service lifetime token")
        elif args.action == "run":
            serve(args.token)
        else:
            stop_service(args.token)
    except (OSError, RuntimeError, subprocess.SubprocessError, StopIteration, KeyError, ValueError) as error:
        print(f"Omasnap: {error}", file=sys.stderr)
        sys.exit(1)
